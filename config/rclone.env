# Required: Local directory to sync
SYNC_ROOT=~/host/sync/

# Required: Remote storage name (e.g., "remote:path")
REMOTE_NAME=gdrive:sync/

# Optional: Additional rclone options
RCLONE_OPTS=""

# Optional: Filter file path (default: filters.txt next to this file)
# Resolved from this file's own location, so the repo works from any clone path
# and when this file is sourced directly without lib/utils.sh.
FILTER_FILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/filters.txt"
